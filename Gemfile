source "https://rubygems.org"

# Built and deployed by GitHub Actions (.github/workflows/pages.yml), so we are
# not limited to the legacy `github-pages` gem and can run current Jekyll.
gem "jekyll", "~> 4.4"
gem "minima", "~> 2.5"

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.18"
  gem "jekyll-seo-tag", "~> 2.9"
  gem "jekyll-sitemap", "~> 1.4"
end
